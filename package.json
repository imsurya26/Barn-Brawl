{
  "name": "barn-brawl", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx --test tests/physics-revision.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": { "@dimforge/rapier3d-compat": "^0.19.3", "three": "^0.180.0", "ws": "^8.18.3", "tsx": "^4.20.6" },
  "devDependencies": { "@playwright/test": "^1.56.0", "@types/node": "^24.0.0", "@types/three": "^0.180.0", "@types/ws": "^8.18.1", "concurrently": "^9.2.1", "typescript": "^5.9.3", "vite": "^7.1.9" }
}
