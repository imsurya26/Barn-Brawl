# Development: Vite proxies /ws to localhost:3001. No variable is necessary.
# Separate static deployment: supply the secure WebSocket URL at build time.
# VITE_GAME_SERVER_URL=wss://game.example.com/ws

# Server environment (set in your shell or hosting dashboard):
# PORT=3001
# ALLOWED_ORIGINS=https://barn.example.com
# MATCH_SECONDS=300
# SITE_DOMAIN=barn.example.com
